{
  "manifest_version": 3,
  "name": "AI Startup Scout (Wide)",
  "version": "1.3.3-wide",
  "description": "AI创业项目智能分析师 -宽屏测试版",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
